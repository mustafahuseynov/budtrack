# Copy to .env and adjust as needed. docker compose reads this file automatically.

POSTGRES_USER=budtrack
POSTGRES_PASSWORD=budtrack
POSTGRES_DB=budtrack
POSTGRES_PORT=55432
APP_PORT=3000

# Used by `npm run dev` and `npm run db:migrate` when running outside Docker.
DATABASE_URL=postgres://budtrack:budtrack@localhost:55432/budtrack
