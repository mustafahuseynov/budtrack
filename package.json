{
  "name": "budtrack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "db:up": "docker compose up -d db"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "lucide-react": "^0.548.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
